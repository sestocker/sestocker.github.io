---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="https://www.w3.org/2005/Atom">

 <title>Scott Stocker</title>
 <link href="https://www.stocker.foo/atom.xml" rel="self"/>
 <link href="https://www.stocker.foo/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>http://tom.preston-werner.com/</id>
 <author>
   <name>Scott Stocker</name>
 </author>

 {% for post in site.posts %}
 <entry>
   <title>{{ post.title }}</title>
   <link href="http://tom.preston-werner.com{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>https://www.stocker.foo{{ post.id }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
